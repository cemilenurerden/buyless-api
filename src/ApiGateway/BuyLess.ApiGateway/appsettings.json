{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/Auth/{**catch-all}"
        }
      },
      "inventory-item-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/Item/{**catch-all}"
        }
      },
      "inventory-category-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/Category/{**catch-all}"
        }
      },
      "inventory-brand-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/Brand/{**catch-all}"
        }
      },
      "inventory-barcode-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/BarcodeProductCache/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "inventory-destination": {
            "Address": "http://localhost:5002"
          }
        }
      }
    }
  }
}